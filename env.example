# Copy to .env and fill in:  cp env.example .env
#
# Deliberately named without a leading dot. The global Claude permission set
# hard-denies Read on `.env` and `.env.*`, and deny beats allow — so a file
# called `.env.example` would be invisible to the agent, defeating its whole
# purpose. This name stays readable while `.env` itself stays protected.
#
# Keys come from the paper dashboard:
#   https://app.alpaca.markets/paper/dashboard/overview

ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXX
ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# THE TRAP: the CLI and the MCP server disagree about which flag means "paper",
# and they disagree in opposite directions. Getting this wrong points a live
# account at an autonomous trading loop.
#
#   MCP server:  ALPACA_PAPER_TRADE=true   -> paper  (opt OUT of paper to go live)
#   CLI:         ALPACA_LIVE_TRADE=true    -> LIVE   (opt IN to live)
#
# Paper therefore means one true and one false. Both are set explicitly below.
# Never delete either line assuming a safe default.
# ─────────────────────────────────────────────────────────────────────────────

ALPACA_PAPER_TRADE=true
ALPACA_LIVE_TRADE=false

# Anthropic key for the proposer and critic calls.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The fresh, hackathon-dedicated paper account ID, submitted to judges so they
# can evaluate P&L. Must be a NEW account at $100,000 — a reused account is
# disqualified from judging.
ALPACA_ACCOUNT_ID=
